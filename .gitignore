/target
**/*.rs.bk
*.log

# 合并操作临时产物
/tmp/
/agent-workspace.bundle

# 任务交付物：finish 工具引导模型把产物写到 artifacts/，属运行期生成
/artifacts/

# 运行时数据（防止 agent.root 未展开时误入版本库）
/~/

# IDE 本地配置
/.vscode/
/.codebuddy/

# 本地配置——防止 API key 等敏感信息泄露
# 说明：配置只存「环境变量名」，但 base_url / 自建端点等仍属本地信息，
# 因此整份 config/config.toml 不入库；模板 config/config.example.toml
# 仅含占位符（sk-xxxx），仍纳入版本。
/config/config.toml
/config/config.*.toml
!/config/config.example.toml
